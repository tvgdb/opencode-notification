{
	"name": "opencode-notification",
	"version": "0.0.5",
	"description": "OpenCode plugin for simple system notifications when permissions are needed, generation completes, or errors occur",
	"keywords": [
		"notification",
		"opencode",
		"opencode-plugin",
		"system-notification"
	],
	"license": "Apache-2.0",
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IdrisGit/opencode-notification.git"
	},
	"files": [
		"dist",
		"schema"
	],
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./tui": {
			"types": "./dist/tui.d.ts",
			"import": "./dist/tui.js",
			"default": "./dist/tui.js"
		},
		"./rpc": {
			"types": "./dist/rpc.d.ts",
			"import": "./dist/rpc.js",
			"default": "./dist/rpc.js"
		}
	},
	"scripts": {
		"prepublishOnly": "bun run compile",
		"compile": "bun run clean && bun run generate-schema && bun build index.ts tui.ts rpc.ts --outdir dist --target bun --format esm --external @opencode/plugin --external @opencode/plugin/tui --external @opencode/plugin/rpc && bunx tsc -p tsconfig.build.json --emitDeclarationOnly",
		"generate-schema": "bun scripts/generate-schema.ts",
		"clean": "rm -rf dist",
		"test": "bun test",
		"lint": "oxlint --ignore-pattern dist .",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check"
	},
	"dependencies": {
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@opencode/plugin": "^2.1.4",
		"@types/bun": "latest",
		"oxfmt": "^0.38.0",
		"oxlint": "^1.51.0",
		"solid-js": "^1.9.15",
		"typescript": "^5"
	},
	"peerDependencies": {
		"@opencode/plugin": ">=2.0.0",
		"typescript": "^5"
	},
	"peerDependenciesMeta": {
		"@opencode/plugin": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
